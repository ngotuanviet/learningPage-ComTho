# Copy to api/.env for local development. Never commit real secrets.
ENV=development
DATABASE_URL=sqlite:///./dev.db
# Production: Neon pooled URL, e.g. postgresql://user:pass@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/db?sslmode=require

# >= 32 random chars: python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Public website origins allowed to call the API (comma separated)
PUBLIC_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Bank account receiving transfers (SePay bank short name, e.g. MBBank, Vietcombank)
BANK_CODE=MBBank
BANK_ACCOUNT=0000000000
BANK_ACCOUNT_NAME=TEN CHU TAI KHOAN

ORDER_CODE_PREFIX=CT
ORDER_TTL_MINUTES=30

# SePay webhook API key (SePay > Webhooks > Chứng thực: API Key). Same value in both places.
SEPAY_WEBHOOK_API_KEY=

# Resend (email). Empty = emails are skipped and only logged.
RESEND_API_KEY=
EMAIL_FROM=Cơm Đốt Thố Hội An <no-reply@tenmien.vn>
EMAIL_REPLY_TO=
